WHATSAPP_ALERT_TEMPLATE_LANG=es
WHATSAPP_CONNECT_TIMEOUT=15
WHATSAPP_TIMEOUT=30
WHATSAPP_MEDIA_TIMEOUT=60

PAYGUARD_REGISTER_THROTTLE=5,60
