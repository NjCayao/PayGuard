META_MODEL_VISION_MAX_TOKENS=1000
META_MODEL_TRANSCRIBE_TIMEOUT=30
META_MODEL_QUERY_MAX_TOKENS=300

WHATSAPP_API_VERSION=v26.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
